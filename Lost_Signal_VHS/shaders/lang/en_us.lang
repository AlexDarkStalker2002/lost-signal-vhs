screen.GENERATION=Tape Generation
screen.CAMCORDER=Camcorder
screen.BROKEN=Broken Signal

option.TAPE_FORMAT=Tape Format
option.TAPE_FORMAT.comment=Selects the recording speed and cassette character that determine effective luma and chroma bandwidth.
value.TAPE_FORMAT.0=VHS SP
value.TAPE_FORMAT.1=VHS LP
value.TAPE_FORMAT.2=VHS SLP
value.TAPE_FORMAT.3=VHS-C
value.TAPE_FORMAT.4=Worn Rental
option.GENERATION_LOSS=Copy Generation
option.GENERATION_LOSS.comment=Compounds color loss, crosstalk, luma quantization, and noise as if the tape had been copied repeatedly.
value.GENERATION_LOSS.0=Master
value.GENERATION_LOSS.1=1st Copy
value.GENERATION_LOSS.2=2nd Copy
value.GENERATION_LOSS.3=3rd Copy
value.GENERATION_LOSS.4=4th Copy
value.GENERATION_LOSS.5=5th Copy
option.TAPE_WEAR=Tape Wear
option.TAPE_WEAR.comment=Adds oxide fading, desaturated line wear, and low-level generation noise.
option.TAPE_DEFECT_MEMORY=Persistent Tape Defects
option.TAPE_DEFECT_MEMORY.comment=Anchors damaged helical tracks to a continuously moving virtual tape instead of regenerating them each frame.
option.DEFECT_DENSITY=Defect Density
option.DEFECT_DENSITY.comment=Controls how often persistent oxide holes and damaged tracks occur.
option.DEFECT_STRENGTH=Defect Strength
option.DEFECT_STRENGTH.comment=Controls RF noise, brightness loss, and chroma loss inside persistent defects.

option.CAMCORDER_ERA=Camera Era
option.CAMCORDER_ERA.comment=Selects the color response of a neutral source, 1980s tube camera, 1990s VHS camcorder, or early digital camcorder.
value.CAMCORDER_ERA.0=Neutral
value.CAMCORDER_ERA.1=1980s Tube
value.CAMCORDER_ERA.2=1990s VHS
value.CAMCORDER_ERA.3=Early Digital
option.CAMCORDER_HUD=Camcorder HUD
option.CAMCORDER_HUD.comment=Records a blinking REC lamp, battery meter, and running MM:SS timecode into the image.
option.DIGITAL_ZOOM=Digital Zoom
option.DIGITAL_ZOOM.comment=Enlarges the center of the camera image before tape damage is applied.
suffix.DIGITAL_ZOOM=x
option.FOCUS_HUNT_STRENGTH=Autofocus Hunting
option.FOCUS_HUNT_STRENGTH.comment=Adds slow correlated focus misses and recovery from a consumer autofocus system.

option.TRACKING_CONTROL=Manual Tracking
option.TRACKING_CONTROL.comment=Moves the rolling mistracking band and biases its horizontal displacement like a VCR tracking dial.
option.RF_INTERFERENCE_STRENGTH=RF Interference
option.RF_INTERFERENCE_STRENGTH.comment=Adds diagonal herringbone carriers and slowly rolling bright radio-interference bands.
option.TAPE_CHEW_STRENGTH=Tape Chew
option.TAPE_CHEW_STRENGTH.comment=Adds rare broad buckled-tape events with warped scan lines and concentrated static.
option.FRAME_REPEAT=Frame Repetition
option.FRAME_REPEAT.comment=Allows a transport stall to repeat the previous fully processed frame.
option.FRAME_REPEAT_FREQUENCY=Repeat Frequency
option.FRAME_REPEAT_FREQUENCY.comment=Chance of a repeated-frame event in each transport event cell.
option.FRAME_REPEAT_STRENGTH=Repeat Strength
option.FRAME_REPEAT_STRENGTH.comment=Controls how completely the previous frame replaces the current image during a stall.
