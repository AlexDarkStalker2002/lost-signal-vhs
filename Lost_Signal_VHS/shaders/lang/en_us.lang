option.QUALITY_LEVEL=Render Quality
option.QUALITY_LEVEL.comment=Performance removes optional texture taps, Balanced keeps the intended look, and Cinematic reserves the full filter for high-end GPUs.
value.QUALITY_LEVEL.0=Performance
value.QUALITY_LEVEL.1=Balanced
value.QUALITY_LEVEL.2=Cinematic
option.SIGNAL_STANDARD=Signal Standard
option.SIGNAL_STANDARD.comment=Selects NTSC 480-line/59.94-field timing or PAL 576-line/50-field timing and alternating chroma phase.
value.SIGNAL_STANDARD.0=NTSC
value.SIGNAL_STANDARD.1=PAL

option.NOISE_STRENGTH=Tape Noise
option.NOISE_STRENGTH.comment=Fine monochrome grain, chroma noise, and sparse dropouts.
option.SCANLINE_STRENGTH=Scanline Strength
option.SCANLINE_STRENGTH.comment=Darkens every third row and adds a moving fine-line pattern.
option.GLITCH_FREQUENCY=Tracking Glitch Frequency
option.GLITCH_FREQUENCY.comment=How often random horizontal blocks tear sideways.
option.GLITCH_STRENGTH=Tracking Glitch Distance
option.GLITCH_STRENGTH.comment=Maximum horizontal displacement during a tracking tear.
option.TIMEBASE_ERROR=Time-Base Error
option.TIMEBASE_ERROR.comment=Continuous smoothly correlated horizontal timing drift across recorded raster lines.
option.STATIC_FREQUENCY=Static Burst Frequency
option.STATIC_FREQUENCY.comment=How often a short burst of interference overwhelms the image.

option.YIQ_SIGNAL=Signal-Accurate YIQ
option.YIQ_SIGNAL.comment=Encodes brightness and color separately so tape chroma can bleed, drift, and lose detail without blurring luminance.
option.CHROMA_PHASE_ERROR=Chroma Phase Wobble
option.CHROMA_PHASE_ERROR.comment=Controls line-dependent hue drift from an unstable analog color subcarrier. Has no effect when Signal-Accurate YIQ is disabled.
option.AUTO_EXPOSURE=Automatic Exposure Pump
option.AUTO_EXPOSURE.comment=Enables delayed whole-frame gain correction when entering darker or brighter spaces.
option.EXPOSURE_PUMP_STRENGTH=Exposure Pump Strength
option.EXPOSURE_PUMP_STRENGTH.comment=Controls how strongly the camcorder gain reacts to large brightness changes.
option.CHROMA_KILLER=Tracking Color Killer
option.CHROMA_KILLER.comment=Lets unstable tracking briefly suppress color while keeping luminance readable.
option.CHROMA_KILLER_STRENGTH=Color Loss Strength
option.CHROMA_KILLER_STRENGTH.comment=Controls how close severe tracking and sync errors get to monochrome.
option.VERTICAL_SYNC_GLITCH=Vertical Sync Failure
option.VERTICAL_SYNC_GLITCH.comment=Enables rare upward rolls or short frozen-frame events when the deck loses vertical lock.
option.SYNC_GLITCH_FREQUENCY=Sync Failure Frequency
option.SYNC_GLITCH_FREQUENCY.comment=Chance of a vertical roll or frame hold in each four-second event cell.
option.SYNC_GLITCH_STRENGTH=Sync Failure Strength
option.SYNC_GLITCH_STRENGTH.comment=Controls vertical roll distance and the opacity of held frames.
option.CHROMA_PERSISTENCE=Separate Chroma Persistence
option.CHROMA_PERSISTENCE.comment=Allows recorded color to linger longer than luminance on moving objects.
option.CHROMA_PERSISTENCE_STRENGTH=Chroma Trail Strength
option.CHROMA_PERSISTENCE_STRENGTH.comment=Controls how much previous-frame color remains during movement.

option.CHROMA_AMOUNT=RGB Separation
option.CHROMA_AMOUNT.comment=Offsets red and blue in opposite horizontal directions.
option.LENS_DISTORTION=Lens Distortion
option.LENS_DISTORTION.comment=Barrel distortion and dark overscan from a cheap camcorder lens.
option.FLICKER_STRENGTH=Exposure Flicker
option.FLICKER_STRENGTH.comment=Fast uneven brightness flutter.
option.FRAME_JITTER=Frame Jitter
option.FRAME_JITTER.comment=Random two-frame camera displacement in screen pixels.
option.WOBBLE_STRENGTH=Handheld Wobble
option.WOBBLE_STRENGTH.comment=Slow imperfect drift in screen pixels.
option.MOTION_SMEAR=Analog Smear
option.MOTION_SMEAR.comment=Horizontal blur and trailing radius in screen pixels.
option.GHOST_STRENGTH=Temporal Ghosting
option.GHOST_STRENGTH.comment=Retains part of the previous processed frame so movement leaves trails.
option.HISTORY_STABILIZATION=History Stabilization
option.HISTORY_STABILIZATION.comment=Rejects implausible previous-frame colors during fast camera turns while preserving smaller tape trails.
option.SPATIAL_ECHO=Spatial Tape Echo
option.SPATIAL_ECHO.comment=Adds a separate one-frame horizontal echo without increasing temporal persistence.
option.SPATIAL_ECHO_STRENGTH=Spatial Echo Strength
option.SPATIAL_ECHO_STRENGTH.comment=Controls the non-temporal high-contrast echo. Performance quality skips this effect.
option.PIXEL_SCALE=Virtual Pixel Size
option.PIXEL_SCALE.comment=Quantizes scene sampling while retaining the real display resolution.

option.LIMINAL_MODE=Liminal Color Space
option.LIMINAL_MODE.comment=Selects no added grade, yellow-green Backrooms lamps, cyan Poolrooms reflections, or underexposed Liminal Night lighting.
value.LIMINAL_MODE.0=Off
value.LIMINAL_MODE.1=Backrooms
value.LIMINAL_MODE.2=Poolrooms
value.LIMINAL_MODE.3=Liminal Night
option.FLUORESCENT_FLICKER=Fluorescent Flicker
option.FLUORESCENT_FLICKER.comment=Adds a rolling mains band, unstable ballast flutter, and occasional soft brownouts.
option.WHITE_BALANCE_DRIFT=White-Balance Drift
option.WHITE_BALANCE_DRIFT.comment=Lets cheap camcorder white balance hunt slowly between warm and cool under artificial light.
option.EXPOSURE_HUNT_STRENGTH=Exposure Hunting
option.EXPOSURE_HUNT_STRENGTH.comment=Adds slow gain breathing that becomes more visible in empty dark spaces.
option.LIMINAL_HAZE=Liminal Haze
option.LIMINAL_HAZE.comment=Adds veiling glare and lifted air around artificial highlights without world-space fog.

option.WASHOUT_STRENGTH=Color Washout
option.WASHOUT_STRENGTH.comment=Reduces saturation and contrast, lifts black, and softens highlights.
option.TINT_STRENGTH=Security Tint
option.TINT_STRENGTH.comment=Adds the sickly green/yellow cast of aging security footage.
option.VIGNETTE_STRENGTH=Dark Corners
option.VIGNETTE_STRENGTH.comment=Darkens corners like an inexpensive old lens.

suffix.GLITCH_STRENGTH= px
suffix.TIMEBASE_ERROR= px
